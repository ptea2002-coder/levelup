# Copy to .env.local for local development. Never commit .env.local.
# These are public browser configuration values; database access must be protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public canonical origin used for metadata and sitemap generation:
NEXT_PUBLIC_SITE_URL=https://levelup-nine-flame.vercel.app

# Optional compatibility fallback for older Supabase projects using the legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
